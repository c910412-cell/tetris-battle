; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="俄羅斯方塊對戰"
run/main_scene="res://Scenes/Lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GodotAIBridgeRuntime="*res://addons/godot_ai_bridge/runtime_bridge.gd"
NetworkManager="*res://Script/NetworkManager.gd"
PlayitClient="*res://Script/PlayitClient.gd"
BattleSettings="*res://Script/BattleSettings.gd"
PlayerSettings="*res://Script/PlayerSettings.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/size/viewport_width.pc=1920
window/size/viewport_height.pc=1080

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai_bridge/plugin.cfg")

